# build outputs (rebuilt by make)
*.riscv
*.o
# model weight blobs: 100 MB - 2.5 GB each, 21 GB in total; `make gen-<model>` in torchvision
# regenerates them bit-for-bit (fixed seed) together with the assembly
*_weights.bin
# generation scratch and logs
.build/
.logs/
__pycache__/
# local torch-mlir venv and its wheel
.tmenv/
.wheels/
.logs_vision_readme.out

# torchaudio: Wav2Letter has a fixed 23M-parameter architecture, its assembly is 1.4 GB (`make gen-wav2letter` / `make gen-wav2letter_waveform` regenerate it)
torchaudio/wav2letter/wav2letter.s
torchaudio/wav2letter_waveform/wav2letter_waveform.s
