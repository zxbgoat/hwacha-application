#map = affine_map<(d0, d1) -> (d0, d1)>
module {
  func.func @net(%arg0: tensor<1x128xf32>) -> tensor<1x128xf32> {
    %cst = arith.constant 0.000000e+00 : f32
    %cst_0 = arith.constant dense_resource<torch_tensor_128_128_torch.float32> : tensor<128x128xf32>
    %cst_1 = arith.constant -1.000000e+00 : f32
    %cst_2 = arith.constant 1.000000e+00 : f32
    %0 = tensor.empty() : tensor<1x128xf32>
    %1 = linalg.fill ins(%cst : f32) outs(%0 : tensor<1x128xf32>) -> tensor<1x128xf32>
    %2 = linalg.matmul ins(%arg0, %cst_0 : tensor<1x128xf32>, tensor<128x128xf32>) outs(%1 : tensor<1x128xf32>) -> tensor<1x128xf32>
    %3 = linalg.generic {indexing_maps = [#map, #map], iterator_types = ["parallel", "parallel"]} ins(%2 : tensor<1x128xf32>) outs(%0 : tensor<1x128xf32>) {
    ^bb0(%in: f32, %out: f32):
      %4 = arith.cmpf ult, %in, %cst_1 : f32
      %5 = arith.select %4, %cst_1, %in : f32
      %6 = arith.cmpf ugt, %5, %cst_2 : f32
      %7 = arith.select %6, %cst_2, %5 : f32
      linalg.yield %7 : f32
    } -> tensor<1x128xf32>
    return %3 : tensor<1x128xf32>
  }
}

